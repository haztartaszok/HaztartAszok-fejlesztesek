CREATE TABLE {databaseOwner}{objectQualifier}ShoppedTogetherProductPairs
(
    PairId INT NOT NULL IDENTITY (1, 1)
        CONSTRAINT PK_ShoppedTogetherProductPairs PRIMARY KEY CLUSTERED,
    ProductAId INT NOT NULL,
    ProductBId INT NOT NULL,
    TogetherCount INT NOT NULL
        CONSTRAINT DF_ShoppedTogetherProductPairs_TogetherCount DEFAULT (0)
)
GO

ALTER TABLE {databaseOwner}{objectQualifier}ShoppedTogetherProductPairs
ADD CONSTRAINT UQ_ShoppedTogetherProductPairs_ProductPair
UNIQUE (ProductAId, ProductBId)
GO

ALTER TABLE {databaseOwner}{objectQualifier}ShoppedTogetherProductPairs
ADD CONSTRAINT CK_ShoppedTogetherProductPairs_ProductOrder
CHECK (ProductAId < ProductBId)
GO

CREATE INDEX IX_ShoppedTogetherProductPairs_ProductAId
ON {databaseOwner}{objectQualifier}ShoppedTogetherProductPairs (ProductAId)
GO

CREATE INDEX IX_ShoppedTogetherProductPairs_ProductBId
ON {databaseOwner}{objectQualifier}ShoppedTogetherProductPairs (ProductBId)
GO


CREATE TABLE {databaseOwner}{objectQualifier}ShoppedTogetherSyncRuns
(
    SyncRunId INT NOT NULL IDENTITY (1, 1)
        CONSTRAINT PK_ShoppedTogetherSyncRuns PRIMARY KEY CLUSTERED,
    StartedOnUtc DATETIME NOT NULL,
    FinishedOnUtc DATETIME NULL,
    WasSuccessful BIT NOT NULL
        CONSTRAINT DF_ShoppedTogetherSyncRuns_WasSuccessful DEFAULT (0),
    LastProcessedOrderId INT NULL,
    ProcessedOrdersCount INT NOT NULL
        CONSTRAINT DF_ShoppedTogetherSyncRuns_ProcessedOrdersCount DEFAULT (0),
    ErrorMessage NVARCHAR(MAX) NULL
)
GO

